APP_NAME=Universal CRM
DEBUG=true

# SQLite (по умолчанию):
DATABASE_URL=sqlite:///./crm.db
# PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://crm:crm@localhost:5432/crm

# true — таблицы создаются при старте (разработка). В продакшене false + `alembic upgrade head`
AUTO_CREATE_SCHEMA=true

# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480
AUTH_COOKIE_SECURE=false

# Защита форм от подделки запросов (CSRF) — оставьте true
CSRF_ENABLED=true
# Ограничение неудачных входов: попыток на email / на IP за окно (секунды)
LOGIN_MAX_ATTEMPTS=5
LOGIN_MAX_ATTEMPTS_PER_IP=30
LOGIN_WINDOW_SECONDS=300
# true, если приложение стоит за nginx/Traefik: IP берётся из X-Forwarded-For
TRUST_PROXY_HEADERS=false

# Импорт из Excel/CSV: максимум строк и размер файла (МБ)
IMPORT_MAX_ROWS=5000
IMPORT_MAX_FILE_MB=5

# Часовой пояс для отображения дат (в БД хранится UTC)
APP_TIMEZONE=Europe/Moscow

# Первый администратор: создаётся при старте, только если в БД нет ни одного пользователя.
# После первого входа можно удалить эти строки.
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=change-me-please
FIRST_ADMIN_NAME=Администратор
