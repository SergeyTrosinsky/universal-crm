# Настройки запуска через Docker. Скопируйте в .env.docker и заполните:
#   cp .env.docker.example .env.docker
# Файл .env.docker с паролями не храните в git.

# --- Обязательно ---
# openssl rand -hex 24   (только буквы и цифры: пароль подставляется в адрес базы)
POSTGRES_PASSWORD=
# openssl rand -hex 32
SECRET_KEY=

# --- Первый администратор (создаётся при первом запуске, пока в базе нет пользователей) ---
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=
FIRST_ADMIN_NAME=Администратор

# --- Общее ---
APP_NAME=Universal CRM
APP_TIMEZONE=Europe/Moscow

# --- Доступ к приложению ---
# 127.0.0.1 — порт виден только на самом сервере (подходит для HTTPS через Caddy).
# 0.0.0.0 — открыть порт наружу (доступ по http://IP-сервера:8000 без домена; для интернета не рекомендуется).
APP_BIND=127.0.0.1
APP_PORT=8000

# --- Домен и HTTPS (запуск с --profile https) ---
DOMAIN=crm.example.com
# При HTTPS поставьте обе строки в true:
AUTH_COOKIE_SECURE=false
TRUST_PROXY_HEADERS=false

# --- Резервные копии ---
BACKUP_KEEP_DAYS=14
BACKUP_INTERVAL_HOURS=24

# --- Импорт ---
IMPORT_MAX_ROWS=5000
IMPORT_MAX_FILE_MB=5
